{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Material Dictation",
  "version": "0.1.0",
  "identifier": "com.fltli.materialdictation",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Material Dictation",
        "width": 1080,
        "height": 700,
        "minWidth": 900,
        "minHeight": 560,
        "center": true,
        "decorations": false,
        "visible": false
      },
      {
        "label": "splashscreen",
        "title": "Material Dictation",
        "url": "splash.html",
        "width": 420,
        "height": 260,
        "center": true,
        "decorations": false,
        "resizable": false,
        "visible": true,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "license": "GPL-3.0-only",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
